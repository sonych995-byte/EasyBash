# ========================
# Enhanced Parsing
# ========================

class CommandParser:
    """Enhanced command parser with better error handling."""
    
    EASY_BASH_COMMANDS = {"for", "rush", "copy", "move", "exit", "help", "find", "batch"}
    
    @staticmethod
    def parse_command(text: str) -> Tuple[Optional[str], List[str]]:
        """
        Parse user input into command and arguments.
        
        Args:
            text: Raw input string
            
        Returns:
            Tuple of (command, list of parts)
        """
        if not text or not text.strip():
            return None, []
        
        # Remove leading/trailing whitespace
        text = text.strip()
        
        # Handle comments
        if text.startswith('#'):
            return None, []
        
        try:
            parts = shlex.split(text)
        except ValueError as error:
            print(f"{Color.RED}Parse error: {error}{Color.RESET}")
            return None, []
        
        if not parts:
            return None, []
        
        command = parts[0].lower()
        if command in CommandParser.EASY_BASH_COMMANDS:
            return command, parts
        
        # Treat unknown commands as shell commands
        return None, parts


# ========================
# Enhanced Path Handling
# ========================

class PathManager:
    """Enhanced path handling with glob support and validation."""
    
    @staticmethod
    def expand_paths(path_pattern: str, base_dir: Optional[Path] = None) -> List[Path]:
        """
        Expand path patterns with glob support.
        
        Args:
            path_pattern: Path pattern (can include wildcards)
            base_dir: Base directory for relative paths
            
        Returns:
            List of expanded Path objects
        """
        if base_dir is None:
            base_dir = Path.cwd()
        
        # Handle pipe-separated paths
        paths = []
        for pattern in path_pattern.split('|'):
            pattern = pattern.strip()
            if not pattern:
                continue
            
            # Expand user and resolve relative paths
            if pattern.startswith('~'):
                pattern = str(Path(pattern).expanduser())
            elif not Path(pattern).is_absolute():
                pattern = str(base_dir / pattern)
            
            # Handle glob patterns
            matched = glob.glob(pattern)
            if matched:
                paths.extend(Path(p).resolve() for p in matched)
            else:
                # Try as regular path
                path_obj = Path(pattern).resolve()
                paths.append(path_obj)
        
        return paths
    
    @staticmethod
    def validate_paths(paths: List[Path], must_exist: bool = True, must_be_dir: bool = False) -> List[Path]:
        """
        Validate paths based on criteria.
        
        Args:
            paths: List of paths to validate
            must_exist: Whether paths must exist
            must_be_dir: Whether paths must be directories
            
        Returns:
            List of valid paths
        """
        valid = []
        for path in paths:
            valid_flag = True
            
            if must_exist and not path.exists():
                print(f"{Color.YELLOW}Warning: path does not exist -> {path}{Color.RESET}")
                valid_flag = False
            
            if must_be_dir and valid_flag and not path.is_dir():
                print(f"{Color.YELLOW}Warning: not a directory -> {path}{Color.RESET}")
                valid_flag = False
            
            if valid_flag:
                valid.append(path)
        
        return valid


