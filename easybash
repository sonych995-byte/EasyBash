class Finder:
    @staticmethod
    def find(pattern, root="."):
        results = list(Path(root).rglob(pattern))
        for r in results:
            cprint(f"[FIND] {r}", Color.CYAN)
        return results


# ============================================================================
# EasyBash Core
# ============================================================================

class EasyBash:
    def __init__(self):
        self.executor = Executor()

    def run(self, raw):
        raw = raw.strip()
        if not raw:
            return

        tokens = shlex.split(raw)
        if not tokens:
            return

        cmd = tokens[0]

        # exit
        if cmd == "exit":
            raise SystemExit

        # copy
        if cmd == "copy":
            return FileOps.copy(tokens[1], tokens[3].split("|"))

        # move
        if cmd == "move":
            return FileOps.move(tokens[1], tokens[3].split("|"))

        # find
        if cmd == "find":
            return Finder.find(tokens[1], tokens[2] if len(tokens) > 2 else ".")

        # CL
        if cmd == "cl":
            root = tokens[1] if len(tokens) > 1 else "."
            exts = None
            empty = "--empty" in tokens
            days = None

            if "--ext" in tokens:
                i = tokens.index("--ext")
                exts = tokens[i+1:]

            if "--days" in tokens:
                i = tokens.index("--days")
                days = int(tokens[i+1])

            return FileManager.cl(root, exts, empty, days)

        # ORG
        if cmd == "org":
            root = tokens[1] if len(tokens) > 1 else "."
            return FileManager.org(root)

        # FIND DUP
        if cmd == "finddup":
            root = tokens[1] if len(tokens) > 1 else "."
            return FileManager.finddup(root)

        # fallback
        return self.executor.single(tokens)


