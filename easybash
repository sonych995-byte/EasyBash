#!/usr/bin/env python3

"""
EasyBash - A simple CLI tool to simplify Bash commands.
"""

import shutil
import shlex
import subprocess
from pathlib import Path
import glob
from typing import List, Optional, Tuple


# ========================
# Constants
# ========================

EASY_BASH_COMMANDS = {"for", "rush", "copy", "move", "exit", "help"}


# ========================
# Parsing
# ========================

def parse_command(text: str) -> Tuple[Optional[str], List[str]]:
    """
    Parse user input into command and arguments.

    Args:
        text: Raw input string

    Returns:
        Tuple of (command, list of parts)
    """
    if not text.strip():
        return None, []

    try:
        parts = shlex.split(text)
    except ValueError as error:
        print(f"Parse error: {error}")
        return None, []

    if not parts:
        return None, []

    command = parts[0]
    if command in EASY_BASH_COMMANDS:
        return command, parts

    return None, parts


# ========================
# Path Handling
# ========================

def validate_paths(paths_str: str) -> List[Path]:
    """
    Validate and return existing directories.

    Args:
        paths_str: Path string separated by "|"

    Returns:
        List of valid Path objects
    """
    valid_paths = []

    for raw_path in paths_str.split("|"):
        raw_path = raw_path.strip()
        if not raw_path:
            continue

        path_obj = Path(raw_path).expanduser().resolve()

        if path_obj.exists() and path_obj.is_dir():
            valid_paths.append(path_obj)
        else:
            print(f"Warning: invalid path -> {raw_path}")

    return valid_paths


# ========================
# Command Execution
# ========================

def run_command(command: List[str], cwd: Optional[Path] = None) -> int:
    """
    Execute a command safely.

    Args:
        command: Command as list
        cwd: Working directory

    Returns:
        Return code
    """
    try:
        print(f"[RUN] {' '.join(command)} (cwd={cwd})")

        result = subprocess.run(
            command,
            cwd=cwd,
            check=False
        )
        return result.returncode

    except Exception as error:
        print(f"Execution error: {error}")
        return 1


# ========================
# EasyBash Commands
# ========================

def handle_rush(cmd_parts: List[str]) -> None:
    """
    rush (path1|path2) (command)

    Execute command inside multiple directories.
    """
    if len(cmd_parts) < 3:
        print("Usage: rush (path1|path2) (command)")
        return

    paths = validate_paths(cmd_parts[1])
    if not paths:
        print("Error: no valid paths")
        return

    command = cmd_parts[2:]

    for path in paths:
        run_command(command, cwd=path)


def handle_for(cmd_parts: List[str]) -> None:
    """
    for (file_pattern) in (path1|path2) (command)

    Execute command on files in multiple directories.
    Supports wildcard patterns.
    """
    if len(cmd_parts) < 5:
        print("Usage: for (file) in (path1|path2) (command)")
        return

    file_pattern = cmd_parts[1]
    paths = validate_paths(cmd_parts[3])

    if not paths:
        print("Error: no valid paths")
        return

    base_command = cmd_parts[4:]

    for path in paths:
        pattern = str(path / file_pattern)
        matched_files = glob.glob(pattern)

        if not matched_files:
            print(f"No match in {path} for {file_pattern}")
            continue

        for file_path in matched_files:
            command = base_command + [file_path]
            run_command(command)

def handle_copy(cmd_parts: List[str]) -> None:
    """
    copy <file> to <path1|path2> <mode>
    mode: dir | dirs
    """
    if len(cmd_parts) < 5:
        print("Usage: copy <file> to <path1|path2> <mode>")
        return

    file_path = Path(cmd_parts[1]).expanduser().resolve()

    if not file_path.exists():
        print(f"Error: file not found -> {file_path}")
        return

    paths_str = cmd_parts[3]
    mode = cmd_parts[4]

    paths = [p.strip() for p in paths_str.split("|") if p.strip()]
    cwd = Path.cwd()

    # -----------------------
    # MODE: dir
    # -----------------------
    if mode == "dir":
        for p in paths:
            dest_dir = Path(p).expanduser().resolve()

            if not dest_dir.exists():
                print(f"Warning: invalid path -> {p}")
                continue

            target = dest_dir / file_path.name
            shutil.copy2(file_path, target)

            print(f"[COPY] {file_path} -> {target}")

    # -----------------------
    # MODE: dirs
    # -----------------------
    elif mode == "dirs":
        target_dir = cwd

        for p in paths:
            target_dir = target_dir / p

        target_dir.mkdir(parents=True, exist_ok=True)

        target = target_dir / file_path.name
        shutil.copy2(file_path, target)

        print(f"[COPY] {file_path} -> {target}")

    else:
        print("Error: mode must be 'dir' or 'dirs'")

def handle_move(cmd_parts: List[str]) -> None:
    """
    move <file> to <path1|path2> <mode>
    mode: dir | dirs
    """
    if len(cmd_parts) < 5:
        print("Usage: move <file> to <path1|path2> <mode>")
        return

    file_path = Path(cmd_parts[1]).expanduser().resolve()

    if not file_path.exists():
        print(f"Error: file not found -> {file_path}")
        return

    paths_str = cmd_parts[3]
    mode = cmd_parts[4]

    paths = [p.strip() for p in paths_str.split("|") if p.strip()]
    cwd = Path.cwd()

    # -----------------------
    # MODE: dir
    # -----------------------
    if mode == "dir":
        for p in paths:
            dest_dir = Path(p).expanduser().resolve()

            if not dest_dir.exists():
                print(f"Warning: invalid path -> {p}")
                continue

            target = dest_dir / file_path.name
            shutil.copy2(file_path, target)

            print(f"[MOVE] copy -> {target}")

        file_path.unlink()
        print(f"[MOVE] removed original -> {file_path}")

    # -----------------------
    # MODE: dirs
    # -----------------------
    elif mode == "dirs":
        target_dir = cwd

        for p in paths:
            target_dir = target_dir / p

        target_dir.mkdir(parents=True, exist_ok=True)

        target = target_dir / file_path.name
        shutil.move(str(file_path), str(target))

        print(f"[MOVE] {file_path} -> {target}")

    else:
        print("Error: mode must be 'dir' or 'dirs'")


# ========================
# Help
# ========================

def show_help() -> None:
    """Display help message."""
    print("""
EasyBash Commands
-----------------

for (file) in (path1|path2) (command)
    Run command on files
    Example:
        for *.py in src|tests python

rush (path1|path2) (command)
    Run command inside directories
    Example:
        rush src|tests ls -la

exit
    Exit program

help
    Show this message
""")


# ========================
# Main Loop
# ========================

def main() -> None:
    """Main program loop."""
    print("EasyBash Shell (type 'help' for commands)")

    while True:
        try:
            text = input("easybash> ")
        except (EOFError, KeyboardInterrupt):
            print("\nExiting...")
            break

        command, parts = parse_command(text)

        if command == "for":
            handle_for(parts)

        elif command == "rush":
            handle_rush(parts)

        elif command == "copy":
            handle_copy(parts)

        elif command == "move":
            handle_move(parts)

        elif command == "help":
            show_help()

        elif command == "exit":
            print("Goodbye!")
            break

        elif parts:
            print(f"Unknown command: {parts[0]}")


if __name__ == "__main__":
    main()
