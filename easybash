# ========================
# Main Application
# ========================

class EasyBash:
    """Main EasyBash application."""
    
    def __init__(self):
        self.config = self._load_config()
        self.executor = CommandExecutor(self.config)
        self.commands = EasyBashCommands(self.executor)
        self.parser = CommandParser()
        self.running = True
    
    def _load_config(self) -> Config:
        """Load configuration from environment variables."""
        config = Config()
        
        # Load from environment
        config.dry_run = os.environ.get('EASYBASH_DRY_RUN', '0').lower() in ('1', 'true', 'yes')
        config.verbose = os.environ.get('EASYBASH_VERBOSE', '0').lower() in ('1', 'true', 'yes')
        
        try:
            workers = os.environ.get('EASYBASH_MAX_WORKERS', '4')
            config.max_workers = int(workers)
        except ValueError:
            pass
        
        return config
    
    def run(self) -> None:
        """Main program loop."""
        self._print_welcome()
        
        while self.running:
            try:
                text = input(f"{Color.BOLD}easybash> {Color.RESET}")
            except (EOFError, KeyboardInterrupt):
                print(f"\n{Color.YELLOW}Exiting...{Color.RESET}")
                break
            
            # Add to history (simplified - would need readline for full history)
            if text.strip():
                self.commands.command_history.append(text)
            
            command, parts = self.parser.parse_command(text)
            
            if command and hasattr(self.commands, f"handle_{command}"):
                # Execute EasyBash command
                handler = getattr(self.commands, f"handle_{command}")
                handler(parts)
            elif command == "exit":
                print(f"{Color.GREEN}Goodbye!{Color.RESET}")
                break
            elif parts:
                # Execute as shell command
                self.executor.run_command(parts)
            # Empty lines and comments are ignored
    
    def _print_welcome(self) -> None:
        """Print welcome message."""
        print(f"""
{Color.BOLD}{Color.CYAN}EasyBash v2.0 - Enhanced Batch Command Tool{Color.RESET}
{Color.BOLD}========================================{Color.RESET}
Type {Color.GREEN}help{Color.RESET} for commands, {Color.GREEN}exit{Color.RESET} to quit
{Color.YELLOW}Mode: {'DRY RUN' if self.config.dry_run else 'LIVE'} | {'Verbose' if self.config.verbose else 'Quiet'}{Color.RESET}
""")


# ========================
# Entry Point
# ========================

def main() -> None:
    """Application entry point."""
    try:
        app = EasyBash()
        app.run()
    except KeyboardInterrupt:
        print(f"\n{Color.YELLOW}Interrupted{Color.RESET}")
        sys.exit(0)
    except Exception as error:
        print(f"{Color.RED}Fatal error: {error}{Color.RESET}")
        sys.exit(1)


if __name__ == "__main__":
    main()