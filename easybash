#!/usr/bin/env python3

import os
import shlex
import subprocess
import shutil
import glob
from pathlib import Path
from typing import List, Tuple, Optional
from concurrent.futures import ThreadPoolExecutor, as_completed


# ============================================================================
# Color System
# ============================================================================

class Color:
    GREEN = "\033[92m"
    RED = "\033[91m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    CYAN = "\033[96m"
    RESET = "\033[0m"


def cprint(text, color=Color.RESET):
    print(f"{color}{text}{Color.RESET}")


# ============================================================================
# Path Manager
# ============================================================================

class PathManager:
    @staticmethod
    def detect_mode(raw: str) -> Tuple[List[str], str]:
        if '|' in raw:
            return [p.strip() for p in raw.split('|')], 'parallel'
        if '>' in raw:
            return [p.strip() for p in raw.split('>')], 'chain'
        return [raw.strip()], 'single'

    @staticmethod
    def expand_glob(paths: List[str]) -> List[str]:
        expanded = []
        for p in paths:
            if any(c in p for c in ('*', '?', '[')):
                matches = glob.glob(p, recursive=True)
                expanded.extend(matches)
            else:
                expanded.append(p)
        return expanded

    @staticmethod
    def filter_dirs(paths: List[str]) -> List[str]:
        out = []
        for p in paths:
            if Path(p).exists():
                out.append(p)
            else:
                cprint(f"[WARN] Path does not exist: {p}", Color.YELLOW)
        return out


# ============================================================================
# Executor
# ============================================================================

class Executor:
    def __init__(self, dry_run=False):
        self.dry_run = dry_run

    def run_cmd(self, cmd, cwd=None):
        if self.dry_run:
            cprint(f"[DRY-RUN] cd {cwd} && {' '.join(cmd)}", Color.YELLOW)
            return 0

        try:
            return subprocess.run(cmd, cwd=cwd).returncode
        except Exception as e:
            cprint(f"[ERROR] {e}", Color.RED)
            return 1

    def parallel(self, paths, cmd):
        paths = PathManager.filter_dirs(PathManager.expand_glob(paths))
        if not paths:
            cprint("[ERROR] No valid paths for parallel execution", Color.RED)
            return
        with ThreadPoolExecutor() as ex:
            futures = [ex.submit(self.run_cmd, cmd, p) for p in paths]
            for f in as_completed(futures):
                f.result()  # wait, ignore return code

    def chain(self, paths, cmd):
        paths = PathManager.filter_dirs(PathManager.expand_glob(paths))
        if not paths:
            cprint("[ERROR] No valid paths for chain execution", Color.RED)
            return
        for p in paths:
            cprint(f"[CHAIN] {p}", Color.BLUE)
            r = self.run_cmd(cmd, p)
            if r != 0:
                cprint("[CHAIN STOP] command failed", Color.RED)
                break

    def single(self, cmd):
        self.run_cmd(cmd)


# ============================================================================
# File Ops
# ============================================================================

class FileOps:
    @staticmethod
    def _strip_quotes(s: str) -> str:
        """Remove surrounding single or double quotes if present."""
        if len(s) >= 2 and (s[0] == s[-1] == '"' or s[0] == s[-1] == "'"):
            return s[1:-1]
        return s

    @staticmethod
    def copy(src, dsts):
        src_path = Path(src)
        if not src_path.exists():
            cprint(f"[ERROR] Source not found: {src}", Color.RED)
            return
        for d in dsts:
            d = Path(FileOps._strip_quotes(d))
            if d.is_dir():
                target = d / src_path.name
            else:
                target = d
            shutil.copy2(src_path, target)
            cprint(f"[COPY] {src} -> {target}", Color.GREEN)

    @staticmethod
    def move(src, dsts):
        FileOps.copy(src, dsts)
        Path(src).unlink()
        cprint(f"[MOVE] removed {src}", Color.GREEN)


# ============================================================================
# Find Command
# ============================================================================

class Finder:
    @staticmethod
    def find(pattern, root="."):
        results = list(Path(root).rglob(pattern))
        if not results:
            cprint(f"[FIND] No matches for '{pattern}' in '{root}'", Color.YELLOW)
        for r in results:
            cprint(f"[FIND] {r}", Color.CYAN)
        return results


# ============================================================================
# Main EasyBash
# ============================================================================

class EasyBash:
    def __init__(self):
        self.executor = Executor(dry_run=False)
        self.fileops = FileOps()

    # ---------------- FOR COMMAND ----------------
    def run_for(self, item, paths, cmd):
        # Expand globs and filter existing directories
        paths = PathManager.filter_dirs(PathManager.expand_glob(paths))
        if not paths:
            cprint("[ERROR] No valid paths for 'for' loop", Color.RED)
            return
        for p in paths:
            cprint(f"[FOR] {item} in {p}", Color.BLUE)
            self.executor.run_cmd(cmd, cwd=p)

    # ---------------- COPY ----------------
    def copy(self, line):
        parts = shlex.split(line)
        if len(parts) < 4 or parts[2] != 'to':
            cprint("[ERROR] Usage: copy SRC to DST1|DST2[|DST3...]", Color.RED)
            return
        src = parts[1]
        dsts = parts[3].split('|')
        FileOps.copy(src, dsts)

    # ---------------- MOVE ----------------
    def move(self, line):
        parts = shlex.split(line)
        if len(parts) < 4 or parts[2] != 'to':
            cprint("[ERROR] Usage: move SRC to DST1|DST2[|DST3...]", Color.RED)
            return
        src = parts[1]
        dsts = parts[3].split('|')
        FileOps.move(src, dsts)

    # ---------------- FIND ----------------
    def find(self, line):
        parts = shlex.split(line)
        if len(parts) < 2:
            cprint("[ERROR] Usage: find PATTERN [ROOT]", Color.RED)
            return
        pattern = parts[1]
        root = parts[2] if len(parts) > 2 else "."
        Finder.find(pattern, root)

    # ---------------- MAIN ----------------
    def run(self, raw):
        raw = raw.strip()
        if not raw:
            return

        # Dry‑run toggles
        if raw == "dry on":
            self.executor.dry_run = True
            cprint("[DRY RUN ON]", Color.YELLOW)
            return
        if raw == "dry off":
            self.executor.dry_run = False
            cprint("[DRY RUN OFF]", Color.YELLOW)
            return

        # COPY
        if raw.startswith("copy"):
            self.copy(raw)
            return

        # MOVE
        if raw.startswith("move"):
            self.move(raw)
            return

        # FIND
        if raw.startswith("find"):
            self.find(raw)
            return

        # FOR command (improved parsing)
        if raw.startswith("for"):
            # Use shlex to tokenize the whole line
            tokens = shlex.split(raw)
            # Expected: for item in path1|path2 ... cmd...
            if len(tokens) < 4 or tokens[2] != 'in':
                cprint("[ERROR] Usage: for ITEM in PATH1|PATH2... COMMAND...", Color.RED)
                return
            item = tokens[1]
            # The token after 'in' may contain '|' and possibly quoted spaces
            paths_token = tokens[3]
            paths = paths_token.split('|')
            # The rest (tokens[4:]) is the command
            cmd = tokens[4:]
            if not cmd:
                cprint("[ERROR] No command specified after paths", Color.RED)
                return
            self.run_for(item, paths, cmd)
            return

        # Normal + pipe system (parallel / chain)
        tokens = shlex.split(raw)
        if not tokens:
            return
        first = tokens[0]

        if '|' in first:
            paths = first.split('|')
            cmd = tokens[1:]
            self.executor.parallel(paths, cmd)
            return

        if '>' in first:
            paths = first.split('>')
            cmd = tokens[1:]
            self.executor.chain(paths, cmd)
            return

        # Single command
        self.executor.single(tokens)


# ============================================================================
# ENTRY
# ============================================================================

if __name__ == "__main__":
    eb = EasyBash()

    cprint("EasyBash v3.2 (Improved)", Color.CYAN)
    cprint("Type 'exit' to quit", Color.YELLOW)
    cprint("Examples:", Color.CYAN)
    cprint("  copy report.txt to backup|archive", Color.GREEN)
    cprint("  move data.csv to processed|archive", Color.GREEN)
    cprint("  find '*.log' ./logs", Color.GREEN)
    cprint("  for f in dir1|dir2 ls -la", Color.GREEN)
    cprint("  dir1|dir2 ls -la         (parallel)", Color.GREEN)
    cprint("  dir1>dir2>dir3 ls -la    (chain)", Color.GREEN)

    while True:
        try:
            cmd = input("EasyBash> ")
            if cmd.strip() == "exit":
                break
            eb.run(cmd)
        except KeyboardInterrupt:
            print()
            break
        except Exception as e:
            cprint(f"[UNEXPECTED ERROR] {e}", Color.RED)
