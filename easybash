# Enhanced Command Execution
# ========================

class CommandExecutor:
    """Enhanced command execution with better output handling."""
    
    def __init__(self, config: Config):
        self.config = config
    
    def run_command(self, command: List[str], cwd: Optional[Path] = None, 
                   capture_output: bool = False) -> Tuple[int, Optional[str], Optional[str]]:
        """
        Execute a command with enhanced features.
        
        Args:
            command: Command as list
            cwd: Working directory
            capture_output: Whether to capture stdout/stderr
            
        Returns:
            Tuple of (return_code, stdout, stderr)
        """
        if self.config.dry_run:
            print(f"{Color.CYAN}[DRY RUN] {' '.join(command)} (cwd={cwd}){Color.RESET}")
            return 0, None, None
        
        try:
            if self.config.verbose:
                print(f"{Color.BLUE}[RUN] {' '.join(command)} (cwd={cwd}){Color.RESET}")
            
            if capture_output:
                result = subprocess.run(
                    command,
                    cwd=cwd,
                    capture_output=True,
                    text=True,
                    check=False
                )
                return result.returncode, result.stdout, result.stderr
            else:
                result = subprocess.run(
                    command,
                    cwd=cwd,
                    check=False
                )
                return result.returncode, None, None
                
        except FileNotFoundError:
            print(f"{Color.RED}Error: Command not found -> {command[0]}{Color.RESET}")
            return 127, None, None
        except Exception as error:
            print(f"{Color.RED}Execution error: {error}{Color.RESET}")
            return 1, None, None
    
    def run_parallel(self, commands: List[Tuple[List[str], Optional[Path]]]) -> List[int]:
        """
        Run multiple commands in parallel.
        
        Args:
            commands: List of (command, cwd) tuples
            
        Returns:
            List of return codes
        """
        results = []
        
        with ThreadPoolExecutor(max_workers=self.config.max_workers) as executor:
            futures = []
            for cmd, cwd in commands:
                future = executor.submit(self.run_command, cmd, cwd)
                futures.append(future)
            
            for future in as_completed(futures):
                results.append(future.result()[0])
        
        return results


# ========================
# Enhanced EasyBash Commands
# ========================

class EasyBashCommands:
    """Enhanced command implementations."""
    
    def __init__(self, executor: CommandExecutor):
        self.executor = executor
        self.command_history: List[str] = []
    
    def handle_rush(self, cmd_parts: List[str]) -> None:
        """
        rush (path1|path2|pattern) (command)
        
        Execute command inside multiple directories with parallel execution.
        """
        if len(cmd_parts) < 3:
            print(f"{Color.RED}Usage: rush (path1|path2|pattern) (command){Color.RESET}")
            return
        
        # Parse paths with glob support
        paths = PathManager.expand_paths(cmd_parts[1])
        paths = PathManager.validate_paths(paths, must_exist=True, must_be_dir=True)
        
        if not paths:
            print(f"{Color.RED}Error: no valid paths found{Color.RESET}")
            return
        
        command = cmd_parts[2:]
        
        if self.executor.config.verbose:
            print(f"{Color.CYAN}Rushing command in {len(paths)} directories...{Color.RESET}")
        
        # Prepare commands for parallel execution
        commands = [(command, path) for path in paths]
        results = self.executor.run_parallel(commands)
        
        # Summary
        success_count = sum(1 for r in results if r == 0)
        print(f"{Color.GREEN}Completed: {success_count}/{len(paths)} successful{Color.RESET}")
    
    def handle_for(self, cmd_parts: List[str]) -> None:
        """
        for (file_pattern) in (path1|path2|pattern) (command)
        
        Execute command on files in multiple directories with glob support.
        """
        if len(cmd_parts) < 5:
            print(f"{Color.RED}Usage: for (file) in (path1|path2|pattern) (command){Color.RESET}")
            return
        
        file_pattern = cmd_parts[1]
        
        # Parse paths with glob support
        paths = PathManager.expand_paths(cmd_parts[3])
        paths = PathManager.validate_paths(paths, must_exist=True, must_be_dir=True)
        
        if not paths:
            print(f"{Color.RED}Error: no valid paths found{Color.RESET}")
            return
        
        base_command = cmd_parts[4:]
        all_files = []
        
        # Find all matching files
        for path in paths:
            full_pattern = str(path / file_pattern)
            matched_files = glob.glob(full_pattern)
            all_files.extend(Path(f).resolve() for f in matched_files)
            
            if self.executor.config.verbose and not matched_files:
                print(f"{Color.YELLOW}No match in {path} for {file_pattern}{Color.RESET}")
        
        if not all_files:
            print(f"{Color.YELLOW}No files found matching pattern{Color.RESET}")
            return
        
        print(f"{Color.CYAN}Found {len(all_files)} files to process{Color.RESET}")
        
        # Prepare commands
        commands = []
        for file_path in all_files:
            command = [arg.replace('{}', str(file_path)) for arg in base_command]
            if '{}' not in ' '.join(base_command):
                command = base_command + [str(file_path)]
            commands.append((command, file_path.parent))
        
        # Execute commands (could be parallelized)
        for cmd, cwd in commands:
            self.executor.run_command(cmd, cwd)
    
    def handle_copy(self, cmd_parts: List[str]) -> None:
        """
        copy <file|pattern> to <path1|path2|pattern> <mode>
        mode: dir | dirs | flat
        """
        if len(cmd_parts) < 5:
            print(f"{Color.RED}Usage: copy <file|pattern> to <path1|path2|pattern> <mode>{Color.RESET}")
            print("  mode: dir (copy to each directory), dirs (create nested), flat (copy to single dir)")
            return
        
        # Handle file patterns
        source_pattern = cmd_parts[1]
        sources = PathManager.expand_paths(source_pattern)
        sources = PathManager.validate_paths(sources, must_exist=True)
        
        if not sources:
            print(f"{Color.RED}Error: no source files found{Color.RESET}")
            return
        
        dest_pattern = cmd_parts[3]
        mode_str = cmd_parts[4].lower()
        
        try:
            mode = OperationMode(mode_str)
        except ValueError:
            print(f"{Color.RED}Error: mode must be 'dir', 'dirs', or 'flat'{Color.RESET}")
            return
        
        # Parse destinations
        dest_paths = PathManager.expand_paths(dest_pattern)
        
        if mode == OperationMode.DIR:
            # Copy to each destination directory
            dest_paths = PathManager.validate_paths(dest_paths, must_exist=True, must_be_dir=True)
            
            for source in sources:
                for dest_dir in dest_paths:
                    target = dest_dir / source.name
                    if not self.executor.config.dry_run:
                        shutil.copy2(source, target)
                    print(f"{Color.GREEN}[COPY] {source} -> {target}{Color.RESET}")
        
        elif mode == OperationMode.DIRS:
            # Create nested directory structure
            if not dest_paths:
                print(f"{Color.RED}Error: destination paths required for 'dirs' mode{Color.RESET}")
                return
            
            base_dir = Path.cwd()
            for part in dest_paths:
                base_dir = base_dir / part.name
            
            base_dir.mkdir(parents=True, exist_ok=True)
            
            for source in sources:
                target = base_dir / source.name
                if not self.executor.config.dry_run:
                    shutil.copy2(source, target)
                print(f"{Color.GREEN}[COPY] {source} -> {target}{Color.RESET}")
        
        elif mode == OperationMode.FLAT:
            # Copy all to a single directory (flatten)
            if len(dest_paths) != 1:
                print(f"{Color.RED}Error: 'flat' mode requires exactly one destination{Color.RESET}")
                return
            
            dest_dir = dest_paths[0]
            dest_dir.mkdir(parents=True, exist_ok=True)
            
            for source in sources:
                target = dest_dir / source.name
                
                # Handle name conflicts
                counter = 1
                original_target = target
                while target.exists() and not self.executor.config.dry_run:
                    target = original_target.parent / f"{original_target.stem}_{counter}{original_target.suffix}"
                    counter += 1
                
                if not self.executor.config.dry_run:
                    shutil.copy2(source, target)
                print(f"{Color.GREEN}[COPY] {source} -> {target}{Color.RESET}")
    
    def handle_move(self, cmd_parts: List[str]) -> None:
        """
        move <file|pattern> to <path1|path2|pattern> <mode>
        mode: dir | dirs | flat
        """
        if len(cmd_parts) < 5:
            print(f"{Color.RED}Usage: move <file|pattern> to <path1|path2|pattern> <mode>{Color.RESET}")
            return
        
        # First perform copy operation
        self.handle_copy(cmd_parts)
        
        # Then remove sources if copy was successful
        if not self.executor.config.dry_run:
            source_pattern = cmd_parts[1]
            sources = PathManager.expand_paths(source_pattern)
            sources = PathManager.validate_paths(sources, must_exist=True)
            
            for source in sources:
                if source.exists():
                    source.unlink()
                    print(f"{Color.GREEN}[MOVE] Removed original: {source}{Color.RESET}")
    
    def handle_find(self, cmd_parts: List[str]) -> None:
        """
        find <pattern> in <path1|path2>
        
        Find files matching pattern in directories.
        """
        if len(cmd_parts) < 4 or cmd_parts[2] != 'in':
            print(f"{Color.RED}Usage: find <pattern> in <path1|path2>{Color.RESET}")
            return
        
        pattern = cmd_parts[1]
        paths = PathManager.expand_paths(cmd_parts[3])
        paths = PathManager.validate_paths(paths, must_exist=True, must_be_dir=True)
        
        found_files = []
        for path in paths:
            matched = path.glob(f"**/{pattern}")
            found_files.extend(matched)
        
        if found_files:
            print(f"{Color.GREEN}Found {len(found_files)} files:{Color.RESET}")
            for file_path in found_files[:20]:  # Limit output
                print(f"  {file_path}")
            if len(found_files) > 20:
                print(f"  ... and {len(found_files) - 20} more")
        else:
            print(f"{Color.YELLOW}No files found matching '{pattern}'{Color.RESET}")
    
    def handle_batch(self, cmd_parts: List[str]) -> None:
        """
        batch <file_with_commands>
        
        Execute commands from a batch file.
        """
        if len(cmd_parts) < 2:
            print(f"{Color.RED}Usage: batch <file_with_commands>{Color.RESET}")
            return
        
        batch_file = Path(cmd_parts[1]).expanduser().resolve()
        
        if not batch_file.exists():
            print(f"{Color.RED}Error: batch file not found -> {batch_file}{Color.RESET}")
            return
        
        try:
            with open(batch_file, 'r') as f:
                commands = f.readlines()
            
            print(f"{Color.CYAN}Executing {len(commands)} commands from {batch_file}{Color.RESET}")
            
            for line_num, line in enumerate(commands, 1):
                line = line.strip()
                if line and not line.startswith('#'):
                    print(f"{Color.BOLD}[{line_num}] {line}{Color.RESET}")
                    # Recursively parse and execute command
                    command, parts = CommandParser.parse_command(line)
                    if command:
                        handler = getattr(self, f"handle_{command}", None)
                        if handler:
                            handler(parts)
                        else:
                            self.executor.run_command(parts)
                    elif parts:
                        self.executor.run_command(parts)
        
        except Exception as error:
            print(f"{Color.RED}Error executing batch file: {error}{Color.RESET}")


